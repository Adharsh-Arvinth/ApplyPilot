[Unit]
Description=ApplyPilot backend (API, cockpit, autopilot)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=/opt/applypilot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/applypilot/venv/bin/python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --log-level info
Restart=always
RestartSec=5
# Keep the server responsive: the autopilot's browser never starves the API
Nice=5
MemoryMax=16G

[Install]
WantedBy=multi-user.target
