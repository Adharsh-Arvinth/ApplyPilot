# ApplyPilot Backend Environment Variables
APPLYPILOT_ENV=development
APPLYPILOT_HOST=0.0.0.0
APPLYPILOT_PORT=8000

# Security (Single-User Bearer Token + AES-256 Storage Encryption)
APPLYPILOT_TOKEN=your_secure_bearer_token_here
APPLYPILOT_ENCRYPTION_KEY=your_fernet_key_base64_here

# FREE LLM Options for Fit Scoring & Question Answering
# Option 1 (Recommended Free): Google Gemini Free Tier from https://aistudio.google.com
GEMINI_API_KEY=

# Option 2 (Alternative Free): Groq Llama 3 Free Tier from https://console.groq.com
GROQ_API_KEY=

# Option 3 (Offline Free): Local Ollama (No internet required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option 4 (Optional Paid): Anthropic Claude API
CLAUDE_API_KEY=

# Push Notifications (Firebase Cloud Messaging Service Account JSON)
FIREBASE_CREDENTIALS_PATH=

# Operational Safety Rails
# Strict default: Live submissions disabled until explicitly toggled on the mobile app
GO_LIVE_ENABLED=false
DAILY_CAP=100
HOURLY_CAP=10
MIN_FIT_SCORE=4.0
MAYBE_FIT_SCORE=3.0

# Paths
DATABASE_URL=sqlite:///./applypilot.db
BACKUP_DIR=C:\Users\adhar\Desktop\job\backups
OUTPUT_DIR=C:\Users\adhar\Desktop\job\output
