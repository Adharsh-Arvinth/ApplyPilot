# ApplyPilot .gitignore

# Environment & Secrets (Never commit credentials)
.env
backend/.env
*.env.local
*firebase*.json
*adminsdk*.json
serviceAccountKey.json

# SQLite Database & Backups
*.db
*.db-shm
*.db-wal
backups/

# Logs
logs/
*.log

# Python & Testing
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Flutter & Dart
.dart_tool/
.packages
build/
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# Android Gradle
app/android/.gradle/
app/android/local.properties
app/android/app/build/
app/android/.idea/
*.iml
.gradle/

# Generated runtime outputs (keep directories, ignore user session files)
output/resumes/*
!output/resumes/.gitkeep
output/screenshots/*
!output/screenshots/.gitkeep

# Legacy / Reference Submodule
career-ops/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
